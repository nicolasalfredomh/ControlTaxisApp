@model ControlTaxisApp.Models.Conductor
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hoja de Vida - Conductor</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
</head>
<body class="bg-light">
    <div class="container my-5" style="max-width: 700px;">
        <div class="card shadow-sm border-start border-primary border-5">
            <div class="card-body p-4">
                <h3 class="fw-bold text-secondary mb-1">
                    <i class="fa-solid fa-id-card text-primary me-2"></i> Hoja de Vida del Conductor
                </h3>
                <p class="text-muted small">Vehículo vinculado: <span class="badge bg-warning text-dark fs-6">@ViewBag.PlacaVehiculo</span></p>
                <hr />

                <form asp-action="GuardarHojaDeVida" enctype="multipart/form-data" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="VehiculoId" />
                    <input type="hidden" asp-for="FotoUrl" />

                    <div class="row align-items-center mb-4">
                        <div class="col-md-4 text-center">
                            <div class="mb-2">
                                @if (!string.IsNullOrEmpty(Model.FotoUrl))
                                {
                                    <img src="@Model.FotoUrl" alt="Foto Conductor" class="rounded-circle img-thumbnail" style="width: 120px; height: 120px; object-fit: cover;" />
                                }
                                else
                                {
                                    <img src="https://via.placeholder.com/120?text=Sin+Foto" alt="Sin Foto" class="rounded-circle img-thumbnail" style="width: 120px; height: 120px; object-fit: cover;" />
                                }
                            </div>
                            <label class="btn btn-outline-secondary btn-sm">
                                <i class="fa-solid fa-camera"></i> Subir Foto <input type="file" name="archivoFoto" class="d-none" accept="image/*" />
                            </label>
                        </div>
                        <div class="col-md-8">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Nombres</label>
                                <input asp-for="Nombre" class="form-control" required placeholder="Ej: Carlos Alberto" />
                                <span asp-validation-for="Nombre" class="text-danger small"></span>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Apellidos</label>
                                <input asp-for="Apellidos" class="form-control" placeholder="Ej: Pérez Gómez" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Teléfono / Celular</label>
                            <input asp-for="Telefono" class="form-control" placeholder="Ej: 3101234567" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Dirección</label>
                            <input asp-for="Direccion" class="form-control" placeholder="Ej: Calle 10 # 20-30" />
                        </div>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="Activo" class="form-check-input" type="checkbox" />
                        <label class="form-check-label fw-bold text-muted" asp-for="Activo">Conductor Activo en la flota</label>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-controller="Vehiculos" asp-action="Index" class="btn btn-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary"><i class="fa-solid fa-save me-1"></i> Guardar Hoja de Vida</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>